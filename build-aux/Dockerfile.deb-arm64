# Cross-builds the arm64 Debian package on an x86_64 machine: Debian 13 with
# the arm64 libraries beside the native ones (multiarch), the same base the
# x86_64 package is built on. Used by `make deb-arm64`. blueprint-compiler
# runs on the build machine and reads GTK's and libadwaita's typelibs, so
# those are installed for this architecture too.
FROM debian:13
ENV DEBIAN_FRONTEND=noninteractive
RUN dpkg --add-architecture arm64 && apt-get update && apt-get install -y --no-install-recommends \
    build-essential pkg-config curl ca-certificates git make gettext blueprint-compiler \
    desktop-file-utils appstream \
    gcc-aarch64-linux-gnu libc6-dev-arm64-cross \
    gir1.2-gtk-4.0 gir1.2-adw-1 python3-gi \
    libgtk-4-dev:arm64 libadwaita-1-dev:arm64 \
    && rm -rf /var/lib/apt/lists/*
ENV RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo PATH=/opt/cargo/bin:$PATH
RUN curl -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain stable --target aarch64-unknown-linux-gnu \
    && cargo install cargo-deb --locked && chmod -R a+rwX /opt/cargo /opt/rustup
ENV CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_LINKER=aarch64-linux-gnu-gcc \
    CC_aarch64_unknown_linux_gnu=aarch64-linux-gnu-gcc \
    PKG_CONFIG_ALLOW_CROSS=1 \
    PKG_CONFIG_PATH=/usr/lib/aarch64-linux-gnu/pkgconfig:/usr/share/pkgconfig \
    PKG_CONFIG_SYSROOT_DIR=/
WORKDIR /src
