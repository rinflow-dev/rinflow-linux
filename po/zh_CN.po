msgid "_Quit Rinflow Agent"
msgstr "退出 Rinflow 后台服务(_Q)"

msgid "_About Rinflow"
msgstr "关于 Rinflow(_A)"

msgid "Main Menu"
msgstr "主菜单"

msgid "Dismiss"
msgstr "知道了"

msgid "Devices"
msgstr "设备"

msgid "This Device"
msgstr "本机"

msgid "Controlling other devices"
msgstr "控制其他设备"

msgid "Ask Again"
msgstr "重新请求"

msgid "Being controlled by other devices"
msgstr "被其他设备控制"

msgid "Arrangement"
msgstr "布局"

msgid "Drag a device to the side of this screen it sits on. The pointer crosses where they touch."
msgstr "把设备拖到它实际所在的那一侧。指针从两者相接的地方穿过去。"

msgid "My Devices"
msgstr "我的设备"

msgid "Add a device by address"
msgstr "通过地址添加设备"

msgid "Add"
msgstr "添加"

msgid "Nearby Devices"
msgstr "附近的设备"

msgid "Devices found on this network that haven't connected yet."
msgstr "在本网络上发现、但还没有连接过的设备。"

msgid "Settings"
msgstr "设置"

msgid "Sharing"
msgstr "共享"

msgid "Share mouse and keyboard"
msgstr "共享鼠标和键盘"

msgid "Off pauses crossing in both directions; devices stay connected."
msgstr "关闭后两个方向都不再穿越；设备保持连接。"

msgid "Only paired devices"
msgstr "仅允许已配对的设备"

msgid "New devices must pair with a six-digit code first."
msgstr "新设备需要先用六位配对码配对。"

msgid "Start when I sign in"
msgstr "登录时启动"

msgid "Keyboard"
msgstr "键盘"

msgid "Modifier keys from a Mac"
msgstr "来自 Mac 的修饰键"

msgid "What ⌘ and Control play as when a Mac controls this device."
msgstr "Mac 控制本机时，⌘ 和 Control 各自对应哪个键。"

msgid "Appearance"
msgstr "外观"

msgid "Theme"
msgstr "主题"

msgid "Language"
msgstr "语言"

msgid "Takes effect the next time the window opens."
msgstr "下次打开窗口时生效。"

msgid "Network"
msgstr "网络"

msgid "Control port (UDP)"
msgstr "控制端口（UDP）"

msgid "Applies after the agent restarts."
msgstr "后台服务重启后生效。"

msgid "About This Device"
msgstr "关于本机"

msgid "Name"
msgstr "名称"

msgid "Certificate fingerprint"
msgstr "证书指纹"

msgid "Agent"
msgstr "后台服务"

msgid "The agent couldn't be started"
msgstr "无法启动后台服务"

msgid "The agent isn't answering"
msgstr "后台服务没有响应"

msgid "The agent and this window are different versions; update both"
msgstr "后台服务和窗口版本不一致，请同时更新两者"

msgid "This device"
msgstr "本机"

msgid "Use one mouse and keyboard across your computers."
msgstr "用一套键鼠操作你的所有电脑。"

msgid "Swap ⌘ and Control (⌘C copies here)"
msgstr "互换 ⌘ 和 Control（⌘C 在本机就是复制）"

msgid "Keep each key in its place"
msgstr "按键保持原位"

msgid "Follow the system"
msgstr "跟随系统"

msgid "Light"
msgstr "浅色"

msgid "Dark"
msgstr "深色"

msgid "Starting the Rinflow agent…"
msgstr "正在启动 Rinflow 后台服务…"

msgid "Not started yet"
msgstr "尚未启动"

msgid "Connected"
msgstr "已连接"

msgid "controlling this device"
msgstr "正在控制本机"

msgid "you are controlling it"
msgstr "你正在控制它"

msgid "Connecting…"
msgstr "正在连接…"

msgid "Online"
msgstr "在线"

msgid "Offline"
msgstr "离线"

msgid "not placed"
msgstr "未放置"

msgid "not paired"
msgstr "未配对"

msgid "Disconnect"
msgstr "断开"

msgid "Connect"
msgstr "连接"

msgid "Place on the left"
msgstr "放到左侧"

msgid "Place on the right"
msgstr "放到右侧"

msgid "Place above"
msgstr "放到上方"

msgid "Place below"
msgstr "放到下方"

msgid "Remove placement"
msgstr "移除放置"

msgid "Forget this device"
msgstr "忘记此设备"

msgid "No devices yet"
msgstr "还没有设备"

msgid "Devices that connect once stay here. Nearby devices are listed below."
msgstr "连接过一次的设备会留在这里。附近的设备列在下面。"

msgid "found"
msgstr "已找到"

msgid "no response"
msgstr "没有响应"

msgid "address not found"
msgstr "找不到该地址"

msgid "searching…"
msgstr "正在查找…"

msgid "Added by address"
msgstr "通过地址添加"

msgid "Remove this address"
msgstr "移除这个地址"

msgid "Nothing nearby"
msgstr "附近没有设备"

msgid "Open Rinflow on another device on this network, or add it by address."
msgstr "在同一网络的另一台设备上打开 Rinflow，或者通过地址添加它。"

msgid "Waiting for the other device to confirm…"
msgstr "等待对方确认…"

msgid "Pair with"
msgstr "配对："

msgid "Check that the other device shows the same six digits, then accept on both."
msgstr "确认对方屏幕上显示同样的六位数字，然后在两边都点接受。"

msgid "Reject"
msgstr "拒绝"

msgid "Accept"
msgstr "接受"

msgid "Forget"
msgstr "忘记"

msgid "It is disconnected, unplaced and unpaired. It shows up again as a nearby device while it is online."
msgstr "它会被断开、移除放置并取消配对。它在线时会重新出现在附近的设备里。"

msgid "Cancel"
msgstr "取消"

msgid "Add a Device by Address"
msgstr "通过地址添加设备"

msgid "For networks that don't carry discovery (guest Wi-Fi, VPNs): the other device's IP address or name. Only one of the two needs the other's address."
msgstr "用于不传递发现广播的网络（访客 Wi-Fi、VPN）：填对方的 IP 地址或设备名。两台设备里只需要一台填另一台的地址。"

msgid "Address"
msgstr "地址"

msgid "Ready: move the pointer off the edge toward a placed device."
msgstr "就绪：把指针推出屏幕边缘，朝向已放置的设备。"

msgid "Ready: placed devices can move their pointer here."
msgstr "就绪：已放置的设备可以把指针移到本机。"

msgid "Connecting to the desktop…"
msgstr "正在连接桌面…"

msgid "Device"
msgstr "设备"

msgid "on the left"
msgstr "在左侧"

msgid "on the right"
msgstr "在右侧"

msgid "above"
msgstr "在上方"

msgid "below"
msgstr "在下方"
