using Gtk 4.0;
using Adw 1;

template $RinflowWindow : Adw.ApplicationWindow {
  title: "Rinflow";
  default-width: 780;
  default-height: 680;
  width-request: 360;
  height-request: 420;

  content: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      [title]
      Adw.ViewSwitcher {
        stack: stack;
        policy: wide;
      }

      // Its menu is built in app/src/window.rs, in the window's language.
      [end]
      MenuButton menu_button {
        icon-name: "open-menu-symbolic";
        primary: true;
        tooltip-text: _("Main Menu");
      }
    }

    content: Adw.ToastOverlay toast_overlay {
      Box {
        orientation: vertical;

        Adw.Banner error_banner {
          // Errors and device names are plain text, not Pango markup.
          use-markup: false;
          button-label: _("Dismiss");
        }

        // A permission the desktop hasn't given, or can't: nothing is shown
        // while both directions work.
        Adw.Banner input_banner {
          use-markup: false;
          button-label: _("Ask Again");
        }

        // A pairing accepted here, waiting for the other device: shown
        // here rather than in a dialog that would block the window.
        Adw.Banner pairing_banner {
          use-markup: false;
          button-label: _("Cancel");
        }

        // Copied files arriving from another device.
        Adw.Banner transfer_banner {
          use-markup: false;
          button-label: _("Cancel");
        }

        Adw.ViewStack stack {
          vexpand: true;

          Adw.ViewStackPage {
            name: "devices";
            title: _("Devices");
            icon-name: "computer-symbolic";

            child: Adw.PreferencesPage devices_page {
              Adw.PreferencesGroup layout_group {
                title: _("Arrangement");
                description: _("Drag a device to where it sits beside this screen.");
              }

              Adw.PreferencesGroup my_devices_group {
                title: _("My Devices");

                [header-suffix]
                Button add_button {
                  valign: center;
                  tooltip-text: _("Add a device by address");

                  styles ["flat"]

                  Adw.ButtonContent {
                    icon-name: "list-add-symbolic";
                    label: _("Add");
                  }
                }
              }

              Adw.PreferencesGroup nearby_group {
                title: _("Nearby Devices");
              }
            };
          }

          Adw.ViewStackPage {
            name: "settings";
            title: _("Settings");
            icon-name: "emblem-system-symbolic";

            child: Adw.PreferencesPage settings_page {
              Adw.PreferencesGroup {
                title: _("Sharing");

                Adw.SwitchRow sharing_row {
                  title: _("Share mouse and keyboard");
                }

                Adw.SwitchRow paired_only_row {
                  title: _("Only paired devices");
                }

                Adw.SwitchRow clipboard_row {
                  title: _("Share the clipboard");
                }

                Adw.SwitchRow autostart_row {
                  title: _("Start when I sign in");
                }
              }

              Adw.PreferencesGroup {
                title: _("Appearance");

                Adw.ComboRow theme_row {
                  title: _("Theme");
                }

                Adw.ComboRow language_row {
                  title: _("Language");
                }
              }
            };
          }

          Adw.ViewStackPage {
            name: "advanced";
            title: _("Advanced");
            icon-name: "preferences-other-symbolic";

            child: Adw.PreferencesPage advanced_page {
              Adw.PreferencesGroup {
                title: _("Crossing");

                Adw.SwitchRow lock_row {
                  title: _("Keep the pointer on this screen");
                }

                Adw.SwitchRow scroll_lock_row {
                  title: _("Scroll Lock keeps the pointer");
                  subtitle: _("While controlling another device");
                }

                Adw.SpinRow delay_row {
                  title: _("Delay before crossing");
                  subtitle: _("Milliseconds");
                  adjustment: Adjustment {
                    lower: 0;
                    upper: 2000;
                    step-increment: 50;
                    page-increment: 250;
                  };
                }

                Adw.SpinRow corner_row {
                  title: _("Corner margin");
                  subtitle: _("Points near a screen corner where the pointer doesn't cross");
                  adjustment: Adjustment {
                    lower: 0;
                    upper: 400;
                    step-increment: 10;
                    page-increment: 50;
                  };
                }
              }

              Adw.PreferencesGroup {
                title: _("Keyboard");

                Adw.ComboRow modifier_row {
                  title: _("Modifier keys from a Mac");
                }
              }

              Adw.PreferencesGroup about_group {
                title: _("About This Device");

                Adw.ActionRow name_row {
                  title: _("Name");

                  styles ["property"]
                }

                Adw.ActionRow fingerprint_row {
                  title: _("Certificate fingerprint");
                  subtitle-selectable: true;

                  styles ["property"]
                }

                Adw.ActionRow version_row {
                  title: _("Agent");

                  styles ["property"]
                }
              }
            };
          }
        }
      }
    };
  };
}
