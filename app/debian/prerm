#!/bin/sh
# Before Rinflow's files are removed or replaced: stop the agent and the
# window of every signed-in user. The agent runs per user (started by the
# window, at sign-in, or as a systemd user service), so the package cannot
# stop it through the system's service manager. On SIGTERM it lets go of the
# other devices and unmounts its file system; left running, it would keep
# sharing from a program that is no longer installed.
#
# After an upgrade the agent starts again when the window is opened or at
# the next sign-in. Settings and paired devices (~/.local/share/rinflow)
# are the user's and stay.
set -e

case "$1" in
    remove|upgrade|deconfigure)
        for unit_user in $(loginctl list-users --no-legend 2>/dev/null | awk '{print $2}'); do
            # A user service enabled with "systemctl --user enable" would
            # start again by itself: stop it where systemd runs for the user.
            systemctl --machine="$unit_user@.host" --user stop rinflow-agent.service 2>/dev/null || true
        done
        pkill -TERM -x rinflow 2>/dev/null || true
        pkill -TERM -x rinflow-agent 2>/dev/null || true
        ;;
esac

exit 0
